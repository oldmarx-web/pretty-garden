---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = '작은정원 — 마음속 정원에 가만히 놓이는 책',
  description = '작은정원은 사진과 문장, 음악과 사람의 이야기를 책으로 엮는 출판사입니다.',
} = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/jpeg" href="/bi.jpg" />
  <link rel="apple-touch-icon" href="/bi.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Noto+Serif+KR:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=Noto+Sans+KR:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  >
</head>
<body>
  <slot />

  <script is:inline>
    // simple scroll reveal
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
    },{threshold:.12});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

    // BGM 토글
    (function(){
      const btn = document.getElementById('bgm-toggle');
      const audio = document.getElementById('bgm-audio');
      if(!btn || !audio) return;
      audio.volume = 0.32;
      btn.addEventListener('click', async ()=>{
        if(audio.paused){
          try{
            await audio.play();
            btn.setAttribute('aria-pressed','true');
          }catch(err){ console.warn('BGM 재생 실패:', err); }
        }else{
          audio.pause();
          btn.setAttribute('aria-pressed','false');
        }
      });
    })();
  </script>
</body>
</html>
