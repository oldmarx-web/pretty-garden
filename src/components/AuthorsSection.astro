---
import { getCollection, render } from 'astro:content';

const authors = (await getCollection('authors'))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  authors.map(async (a) => {
    const { Content } = await render(a);
    return { author: a, Content };
  })
);
---
<section class="sec" id="authors">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">Authors</h2>
      <div class="sec-kicker">함께한 사람들</div>
    </div>
    <div class="authors">
      {rendered.map(({ author, Content }) => (
        <div class="author-card reveal">
          <h4>{author.data.name}</h4>
          <div class="role">{author.data.role}</div>
          <div class="bio"><Content /></div>
          {author.data.works?.length > 0 && (
            <div class="titles">
              출간작 — {author.data.works.map((w, i) => (
                <>
                  {i > 0 && ', '}
                  <em>{w}</em>
                </>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
