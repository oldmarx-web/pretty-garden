---
import { getCollection } from 'astro:content';

const books = (await getCollection('books'))
  .sort((a, b) => a.data.order - b.data.order);

function fmtDate(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
}
function fmtPrice(p: number) {
  return '₩ ' + p.toLocaleString('en-US');
}
---
<section class="sec" id="books">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">Catalogue</h2>
      <div class="sec-kicker">출간 도서</div>
    </div>

    <div class="grid">
      {books.map((book) => {
        const kyoboUrl = `https://product.kyobobook.co.kr/detail/${book.data.kyoboId}`;
        const coverUrl = `https://contents.kyobobook.co.kr/sih/fit-in/458x0/pdt/${book.data.coverIsbn}.jpg`;
        return (
          <article class="book reveal">
            <a class="cover" href={kyoboUrl} target="_blank" rel="noopener">
              <img src={coverUrl} alt={`${book.data.title} 표지`}/>
            </a>
            <div>
              <div class="book-meta">
                {book.data.isNew && (
                  <span class="tag new">{book.data.tag ?? `New · ${book.data.publishDate.getFullYear()}`}</span>
                )}
                {!book.data.isNew && book.data.tag && (
                  <span class="tag">{book.data.tag}</span>
                )}
                <span>{book.data.genre}</span>
                <span>{fmtDate(book.data.publishDate)}</span>
              </div>
              <h3 set:html={book.data.title.replace(/, /g, ',<br/>')} />
              <p class="author">{book.data.authorRole} <b>{book.data.author}</b></p>
              <p class="desc">{book.data.description}</p>
              <div class="links">
                <a class="btn" href={kyoboUrl} target="_blank" rel="noopener">
                  교보문고에서 보기 <span class="arr">→</span>
                </a>
                <span class="price">{fmtPrice(book.data.price)}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
