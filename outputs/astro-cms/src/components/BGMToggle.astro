---
// 화면 우측 하단 BGM 토글 — Bach Prelude (CC0)
---
<div class="bgm" role="region" aria-label="배경 음악">
  <button id="bgm-toggle" class="bgm-btn" aria-pressed="false" aria-label="배경 음악 재생/정지">
    <span class="bgm-icon" aria-hidden="true">♪</span>
    <span class="bgm-label">Bach · BWV 846</span>
  </button>
  <audio id="bgm-audio" loop preload="none">
    <source src="/bgm.mp3" type="audio/mpeg">
    <source src="/bgm.ogg" type="audio/ogg">
  </audio>
</div>
